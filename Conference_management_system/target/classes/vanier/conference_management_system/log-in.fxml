<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="1080.0" prefWidth="1920.0" styleClass="background" stylesheets="@log-in.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vanier.conference_management_system.Controller">
   <children>
      <Label fx:id="titleLabel" styleClass="title-label" text="ConCentral">
         <font>
            <Font name="System Bold" size="50.0" />
         </font>
         <VBox.margin>
            <Insets bottom="100.0" />
         </VBox.margin>
      </Label>
      <VBox alignment="CENTER" maxWidth="500.0" prefHeight="327.0" prefWidth="500.0" styleClass="log-in-vbox">
         <children>
            <Label text="Sign in">
               <font>
                  <Font name="System Bold" size="30.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="50.0" top="10.0" />
               </VBox.margin></Label>
            <TextField fx:id="emailTextField" promptText="Email">
               <font>
                  <Font size="20.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="20.0" left="50.0" right="50.0" />
               </VBox.margin></TextField>
            <TextField fx:id="passwordFieldText" promptText="Password">
               <font>
                  <Font size="20.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="20.0" left="50.0" right="50.0" />
               </VBox.margin></TextField>
            <Button fx:id="logInButton" mnemonicParsing="false" text="Log in">
               <font>
                  <Font size="20.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="20.0" />
               </VBox.margin></Button>
            <Hyperlink fx:id="signUpHyperlink" text="Don't have an account?">
               <font>
                  <Font size="20.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin></Hyperlink>
         </children>
         <VBox.margin>
            <Insets />
         </VBox.margin>
      </VBox>
   </children>
</VBox>
