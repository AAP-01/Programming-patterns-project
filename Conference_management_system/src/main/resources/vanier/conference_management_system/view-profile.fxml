<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="0.0" minWidth="0.0" prefHeight="1080.0" prefWidth="1920.0" styleClass="background" stylesheets="@dashboard.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vanier.conference_management_system.Controller">
    <left>
        <fx:include source="side-bar.fxml" />
    </left>
   <center>
          <VBox alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" BorderPane.alignment="CENTER">
              <children>
            <StackPane>
               <children>
                        <Label alignment="CENTER" minHeight="-Infinity" minWidth="-Infinity" prefWidth="400.0" styleClass="title-label" text="Profile" textAlignment="CENTER">
                            <font>
                                <Font name="System Bold" size="30.0" />
                            </font>
                            <padding>
                                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                            </padding>
                     <StackPane.margin>
                        <Insets top="50.0" />
                     </StackPane.margin>
                        </Label>
               </children>
               <VBox.margin>
                  <Insets bottom="100.0" />
               </VBox.margin>
            </StackPane>
            <VBox alignment="CENTER" maxWidth="-Infinity" prefHeight="304.0" prefWidth="500.0" styleClass="profile-vbox">
               <children>
                  <HBox alignment="CENTER" prefHeight="0.0" prefWidth="1529.0">
                     <children>
                        <Label prefWidth="200.0" text="First name">
                           <font>
                              <Font size="20.0" />
                           </font>
                           <HBox.margin>
                              <Insets />
                           </HBox.margin>
                        </Label>
                        <TextField fx:id="firstNameChangeProfileTextField" />
                     </children>
                     <VBox.margin>
                        <Insets bottom="20.0" top="20.0" />
                     </VBox.margin>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="0.0" prefWidth="1529.0">
                     <children>
                        <Label prefWidth="200.0" text="Last name">
                           <font>
                              <Font size="20.0" />
                           </font>
                           <HBox.margin>
                              <Insets />
                           </HBox.margin>
                        </Label>
                        <TextField fx:id="lastNameChangeProfileTextField" />
                     </children>
                     <VBox.margin>
                        <Insets bottom="20.0" />
                     </VBox.margin>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="0.0" prefWidth="1529.0">
                     <children>
                        <Label prefWidth="200.0" text="Email">
                           <font>
                              <Font size="20.0" />
                           </font>
                           <HBox.margin>
                              <Insets />
                           </HBox.margin>
                        </Label>
                        <TextField fx:id="emailChangeProfileTextField" />
                     </children>
                     <VBox.margin>
                        <Insets bottom="20.0" />
                     </VBox.margin>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="5.0" prefWidth="1529.0">
                     <children>
                        <Label prefWidth="200.0" text="Age">
                           <font>
                              <Font size="20.0" />
                           </font>
                        </Label>
                        <TextField fx:id="ageChangeProfileTextField" />
                     </children>
                     <VBox.margin>
                        <Insets bottom="20.0" />
                     </VBox.margin>
                  </HBox>
                  <Button fx:id="saveChangesButton" mnemonicParsing="false" onAction="#onSaveChangesButtonClick" text="Save Changes">
                     <font>
                        <Font size="20.0" />
                     </font>
                     <VBox.margin>
                        <Insets bottom="20.0" />
                     </VBox.margin>
                  </Button>
               </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </VBox>
              </children>
          </VBox>
   </center>
</BorderPane>
